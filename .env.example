# Copy to .env.local, fill in real values, then run: chmod 600 .env.local
# Identifiers must match ^[a-z][a-z0-9_]{0,62}$

# Privileged bootstrap login for the postgres image (never used by the app).
POSTGRES_DB=ledger
POSTGRES_USER=ledger_admin
POSTGRES_PASSWORD=change-me-random-bootstrap-password

# Restricted application login, created on first database initialisation.
LEDGER_DB_USER=ledger_app
LEDGER_DB_PASSWORD=change-me-random-app-password

# Application connection URL. Username and password must URL-decode to the
# LEDGER_DB_* values above (percent-encode special characters). Fixed
# host, port, and database; no query options.
DATABASE_URL=postgresql://ledger_app:change-me-random-app-password@127.0.0.1:5432/ledger

# Dedicated migration login, provisioned on first initialisation or by
# `pnpm db:provision-migration-role` on an existing volume. CLI use only;
# the app never loads it.
LEDGER_MIGRATION_USER=ledger_migrate
LEDGER_MIGRATION_PASSWORD=change-me-random-migration-password
MIGRATION_DATABASE_URL=postgresql://ledger_migrate:change-me-random-migration-password@127.0.0.1:5432/ledger

# Owner token key settings, required only for token encrypt and decrypt
# operations. The path is an absolute private file outside the repository,
# mode 0600, created by `pnpm db:create-token-key`. The key ID is a stable
# nonsecret identifier for the envelope.
LEDGER_TOKEN_KEY_PATH=/absolute/private/path/ledger-token-key
LEDGER_TOKEN_KEY_ID=ledger-token-key-v1

# Isolated test database. Names use a ledger_test prefix and differ from
# the application and migration values above.
TEST_DATABASE_URL=postgresql://ledger_test_app:change-me@127.0.0.1:5433/ledger_test_main
TEST_MIGRATION_DATABASE_URL=postgresql://ledger_test_migrate:change-me@127.0.0.1:5433/ledger_test_main
