          "value": "((\"ledger\".\"transaction\".\"posting_state\" = 'posted' AND \"ledger\".\"transaction\".\"posted_date\" IS NOT NULL) OR (\"ledger\".\"transaction\".\"posting_state\" = 'pending' AND \"ledger\".\"transaction\".\"posted_date\" IS NULL))"
