          "value": "\"ledger\".\"transaction\".\"classification_intent\" IN ('untouched', 'override', 'reset', 'inherited')"
        },
        "transaction_category_intent_consistency": {
          "name": "transaction_category_intent_consistency",
          "value": "((\"ledger\".\"transaction\".\"category_intent\" IN ('untouched', 'reset') AND \"ledger\".\"transaction\".\"owner_category_id\" IS NULL AND \"ledger\".\"transaction\".\"category_inherited_from_id\" IS NULL) OR (\"ledger\".\"transaction\".\"category_intent\" = 'override' AND \"ledger\".\"transaction\".\"owner_category_id\" IS NOT NULL AND \"ledger\".\"transaction\".\"category_inherited_from_id\" IS NULL) OR (\"ledger\".\"transaction\".\"category_intent\" = 'inherited' AND \"ledger\".\"transaction\".\"owner_category_id\" IS NOT NULL AND \"ledger\".\"transaction\".\"category_inherited_from_id\" IS NOT NULL))"
        },
        "transaction_classification_intent_consistency": {
          "name": "transaction_classification_intent_consistency",
          "value": "((\"ledger\".\"transaction\".\"classification_intent\" IN ('untouched', 'reset') AND \"ledger\".\"transaction\".\"owner_classification\" IS NULL AND \"ledger\".\"transaction\".\"classification_inherited_from_id\" IS NULL) OR (\"ledger\".\"transaction\".\"classification_intent\" = 'override' AND \"ledger\".\"transaction\".\"owner_classification\" IS NOT NULL AND \"ledger\".\"transaction\".\"classification_inherited_from_id\" IS NULL) OR (\"ledger\".\"transaction\".\"classification_intent\" = 'inherited' AND \"ledger\".\"transaction\".\"owner_classification\" IS NOT NULL AND \"ledger\".\"transaction\".\"classification_inherited_from_id\" IS NOT NULL))"
